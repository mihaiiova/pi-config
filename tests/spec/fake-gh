#!/usr/bin/env bash
# Fake `gh` for offline testing of scripts/spec/apply-plan.sh.
#
# State lives under $FAKE_GH_STATE_DIR (one issue-N.json per created issue).
# Every invocation is appended to $FAKE_GH_LOG. Set $FAKE_GH_FAIL_ON_CREATE=N
# to make the Nth `gh issue create` fail, for partial-failure tests.
set -euo pipefail

STATE="${FAKE_GH_STATE_DIR:?FAKE_GH_STATE_DIR is required}"
LOG="${FAKE_GH_LOG:-$STATE/calls.log}"
mkdir -p "$STATE"
printf '%s\n' "$*" >> "$LOG"

repo=""
args=("$@")
for i in "${!args[@]}"; do
  if [[ "${args[$i]}" == "--repo" ]]; then repo="${args[$((i+1))]}"; fi
done
repo="${repo:-owner/repo}"

cmd="${1:-}"

case "$cmd" in
  repo)
    printf '%s\n' "$repo"
    ;;
  label)
    exit 0
    ;;
  issue)
    sub="${2:-}"
    case "$sub" in
      create)
        title=""; body_file=""; labels=()
        i=0
        while [[ $i -lt ${#args[@]} ]]; do
          case "${args[$i]}" in
            --title) title="${args[$((i+1))]}"; i=$((i+1));;
            --body-file) body_file="${args[$((i+1))]}"; i=$((i+1));;
            --label) labels+=("${args[$((i+1))]}"); i=$((i+1));;
          esac
          i=$((i+1))
        done
        max=0
        for f in "$STATE"/issue-*.json; do
          [[ -e "$f" ]] || continue
          n="$(jq -r '.number' "$f")"
          [[ "$n" -gt "$max" ]] && max="$n"
        done
        next=$((max + 1))
        creates="$(cat "$STATE/.create_count" 2>/dev/null || printf 0)"
        creates=$((creates + 1))
        printf '%s' "$creates" > "$STATE/.create_count"
        if [[ "${FAKE_GH_FAIL_ON_CREATE:-}" == "$creates" ]]; then
          echo "fake gh: simulated create failure" >&2
          exit 1
        fi
        body=""
        [[ -n "$body_file" ]] && body="$(cat "$body_file")"
        labels_json='[]'
        if [[ ${#labels[@]} -gt 0 ]]; then
          labels_json="$(printf '%s\n' "${labels[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')"
        fi
        jq -n --arg n "$next" --arg t "$title" --arg b "$body" --argjson l "$labels_json" \
          --arg u "https://github.com/$repo/issues/$next" \
          '{number:($n|tonumber), title:$t, body:$b, url:$u, labels:$l}' > "$STATE/issue-$next.json"
        printf 'https://github.com/%s/issues/%s\n' "$repo" "$next"
        ;;
      list)
        shopt -s nullglob
        files=("$STATE"/issue-*.json)
        shopt -u nullglob
        if [[ ${#files[@]} -eq 0 ]]; then
          echo '[]'
        else
          jq -s '[.[] | {number,title,body,url,labels}]' "${files[@]}"
        fi
        ;;
      view)
        num="${args[2]}"
        jq -c '.labels // []' "$STATE/issue-$num.json"
        ;;
      edit)
        num="${args[2]}"
        body_file=""; title=""; add_label=""; remove_label=""
        for i in "${!args[@]}"; do
          case "${args[$i]}" in
            --body-file) body_file="${args[$((i+1))]}" ;;
            --title) title="${args[$((i+1))]}" ;;
            --add-label) add_label="${args[$((i+1))]}" ;;
            --remove-label) remove_label="${args[$((i+1))]}" ;;
          esac
        done
        if [[ -n "$body_file" ]]; then
          jq --arg b "$(cat "$body_file")" '.body = $b' "$STATE/issue-$num.json" > "$STATE/issue-$num.json.tmp"
          mv "$STATE/issue-$num.json.tmp" "$STATE/issue-$num.json"
        fi
        if [[ -n "$title" ]]; then
          jq --arg t "$title" '.title = $t' "$STATE/issue-$num.json" > "$STATE/issue-$num.json.tmp"
          mv "$STATE/issue-$num.json.tmp" "$STATE/issue-$num.json"
        fi
        if [[ -n "$add_label" ]]; then
          jq --arg l "$add_label" '.labels = (((.labels // []) + [$l]) | unique)' "$STATE/issue-$num.json" > "$STATE/issue-$num.json.tmp"
          mv "$STATE/issue-$num.json.tmp" "$STATE/issue-$num.json"
        fi
        if [[ -n "$remove_label" ]]; then
          jq --arg l "$remove_label" '.labels = [(.labels // [])[] | select(. != $l)]' "$STATE/issue-$num.json" > "$STATE/issue-$num.json.tmp"
          mv "$STATE/issue-$num.json.tmp" "$STATE/issue-$num.json"
        fi
        exit 0
        ;;
      *)
        echo "fake gh: unsupported issue subcommand: $sub" >&2; exit 2 ;;
    esac
    ;;
  *)
    echo "fake gh: unsupported command: $cmd" >&2; exit 2 ;;
esac

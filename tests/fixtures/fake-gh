#!/usr/bin/env bash
set -euo pipefail

: "${FAKE_GH_DIR:?FAKE_GH_DIR is required}"
mkdir -p "$FAKE_GH_DIR"
printf '%q ' "$@" >> "$FAKE_GH_DIR/calls.log"
printf '\n' >> "$FAKE_GH_DIR/calls.log"

if [[ "${1:-}" == "api" ]]; then
  endpoint=""
  method="GET"
  previous=""
  for arg in "$@"; do
    if [[ "$previous" == "--method" ]]; then
      method="$arg"
    elif [[ "$arg" == repos/* ]]; then
      endpoint="$arg"
    fi
    previous="$arg"
  done

  case "$endpoint" in
    */collaborators/*/permission)
      printf '%s\n' "${FAKE_PERMISSION:-write}"
      ;;
    *'/issues?state=all&per_page=100')
      if [[ -n "${FAKE_ISSUES_SNAPSHOT:-}" ]]; then
        cat "$FAKE_ISSUES_SNAPSHOT"
      else
        printf '[[]]\n'
      fi
      ;;
    */issues/[0-9]*)
      if [[ -n "${FAKE_ISSUE_JSON:-}" ]]; then
        printf '%s\n' "$FAKE_ISSUE_JSON"
      else
        printf '{"labels":[]}\n'
      fi
      ;;
    */labels/*)
      if [[ "${FAKE_LABEL_EXISTS:-false}" != "true" ]]; then
        exit 1
      fi
      printf '{}\n'
      ;;
    */labels)
      [[ "$method" == "POST" ]]
      printf '{}\n'
      ;;
    *)
      printf '{}\n'
      ;;
  esac
  exit 0
fi

if [[ "${1:-}" == "issue" && "${2:-}" == "create" ]]; then
  count_file="$FAKE_GH_DIR/create-count"
  count=0
  [[ -f "$count_file" ]] && count="$(< "$count_file")"
  count=$((count + 1))
  printf '%s\n' "$count" > "$count_file"

  title=""
  body=""
  previous=""
  for arg in "$@"; do
    [[ "$previous" == "--title" ]] && title="$arg"
    [[ "$previous" == "--body" ]] && body="$arg"
    previous="$arg"
  done
  printf '%s\n' "$title" > "$FAKE_GH_DIR/create-$count.title"
  printf '%s\n' "$body" > "$FAKE_GH_DIR/create-$count.body"
  printf 'https://example.test/issues/%s\n' "$((100 + count))"
  exit 0
fi

if [[ "${1:-}" == "issue" && "${2:-}" == "comment" ]]; then
  body=""
  previous=""
  for arg in "$@"; do
    if [[ "$previous" == "--body" ]]; then
      body="$arg"
    elif [[ "$previous" == "--body-file" ]]; then
      body="$(< "$arg")"
    fi
    previous="$arg"
  done
  printf '%s\n' "$body" > "$FAKE_GH_DIR/last-comment"
  exit 0
fi

if [[ "${1:-}" == "issue" && ( "${2:-}" == "edit" || "${2:-}" == "close" ) ]]; then
  exit 0
fi

echo "Unsupported fake gh invocation: $*" >&2
exit 2
